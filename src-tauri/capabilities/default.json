{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only Localis' own commands (projects, library, jobs, chat, cloud providers). No plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-list-projects",
    "allow-create-project",
    "allow-delete-project",
    "allow-list-folders",
    "allow-create-folder",
    "allow-rename-folder",
    "allow-delete-folder",
    "allow-list-documents",
    "allow-list-versions",
    "allow-import-document",
    "allow-import-version",
    "allow-move-document",
    "allow-delete-document",
    "allow-read-original",
    "allow-get-text",
    "allow-search",
    "allow-list-jobs",
    "allow-retry-job",
    "allow-get-llm-settings",
    "allow-set-llm-settings",
    "allow-get-llm-status",
    "allow-get-embedding-status",
    "allow-list-conversations",
    "allow-create-conversation",
    "allow-delete-conversation",
    "allow-list-messages",
    "allow-send-message",
    "allow-cancel-generation",
    "allow-get-keyring-status",
    "allow-list-providers",
    "allow-set-api-key",
    "allow-delete-api-key",
    "allow-list-provider-models",
    "allow-list-prices",
    "allow-set-price",
    "allow-delete-price",
    "allow-set-project-cloud-policy",
    "allow-estimate-cloud-embedding",
    "allow-set-cloud-embedding-consent",
    "allow-prepare-cloud-send",
    "allow-discard-cloud-send",
    "allow-list-cloud-requests"
  ]
}
