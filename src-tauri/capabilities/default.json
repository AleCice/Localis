{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only Localis' own commands (projects, library, jobs, local chat). No plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-list-projects",
    "allow-create-project",
    "allow-delete-project",
    "allow-list-folders",
    "allow-create-folder",
    "allow-rename-folder",
    "allow-delete-folder",
    "allow-list-documents",
    "allow-list-versions",
    "allow-import-document",
    "allow-import-version",
    "allow-move-document",
    "allow-delete-document",
    "allow-read-original",
    "allow-get-text",
    "allow-search",
    "allow-list-jobs",
    "allow-retry-job",
    "allow-get-llm-settings",
    "allow-set-llm-settings",
    "allow-get-llm-status",
    "allow-get-embedding-status",
    "allow-list-conversations",
    "allow-create-conversation",
    "allow-delete-conversation",
    "allow-list-messages",
    "allow-send-message",
    "allow-cancel-generation"
  ]
}
